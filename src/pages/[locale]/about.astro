---
import Layout from '../../layouts/Layout.astro';import {text,locales,href,type Locale} from '../../data/i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale}}));}const locale=Astro.params.locale as Locale;const t=text[locale];
const content={
  "en": [
    [
      "About apps308",
      "apps308 helps you discover useful apps, websites and reward programs. Find practical explanations, features to explore and tips for choosing what fits your daily life."
    ],
    [
      "What you will find here",
      "Our guides cover how to get started, useful features, strengths and limitations. For reward programs, we explain the type of reward, redemption requirements and processing information published by the provider."
    ],
    [
      "Explore in your language",
      "Read in English, Spanish or Portuguese. Use the language selector to open the equivalent guide and keep exploring."
    ],
    [
      "Up-to-date information",
      "Features, offers and regional availability can change. Each guide includes links to the provider’s product and support pages for current details."
    ]
  ],
  "es": [
    [
      "Acerca de apps308",
      "apps308 te ayuda a descubrir apps, sitios útiles y programas de recompensas. Encuentra explicaciones prácticas, funciones para explorar y consejos para elegir lo que encaja con tu día a día."
    ],
    [
      "Qué encontrarás aquí",
      "Las guías explican cómo empezar, funciones útiles, ventajas y aspectos a considerar. Para las recompensas, detallamos el tipo de beneficio, los requisitos de canje y los plazos publicados por el proveedor."
    ],
    [
      "Explora en tu idioma",
      "Lee en español, inglés o portugués. El selector de idioma abre la guía equivalente para seguir explorando."
    ],
    [
      "Información actualizada",
      "Las funciones, ofertas y disponibilidad regional pueden cambiar. Cada guía enlaza las páginas del producto y de soporte para consultar los detalles vigentes."
    ]
  ],
  "pt": [
    [
      "Sobre o apps308",
      "O apps308 ajuda você a descobrir aplicativos, sites úteis e programas de recompensas. Encontre explicações práticas, recursos para explorar e dicas para escolher o que combina com seu dia a dia."
    ],
    [
      "O que você encontra por aqui",
      "Os guias explicam como começar, recursos úteis, pontos positivos e o que considerar. Nos programas de recompensas, detalhamos o tipo de benefício, os requisitos de resgate e os prazos publicados pelo fornecedor."
    ],
    [
      "Explore no seu idioma",
      "Leia em português, inglês ou espanhol. Use o seletor de idioma para abrir o guia equivalente e continuar explorando."
    ],
    [
      "Informações atualizadas",
      "Recursos, ofertas e disponibilidade regional podem mudar. Cada guia inclui links para as páginas do produto e de suporte, onde você pode conferir os detalhes atuais."
    ]
  ]
};
---
<Layout locale={locale} title={`${t.about} | apps308`} description={content[locale][0][1]} alternates={Object.fromEntries(locales.map(l=>[l,href(l,'about')]))}><div class="policy wrap"><h1>{content[locale][0][0]}</h1><p>{content[locale][0][1]}</p>{content[locale].slice(1).map(([h,p])=><section><h2>{h}</h2><p>{p}</p></section>)}</div></Layout>
