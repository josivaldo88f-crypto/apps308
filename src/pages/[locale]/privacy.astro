---
import Layout from '../../layouts/Layout.astro';import {text,locales,href,type Locale} from '../../data/i18n';
export function getStaticPaths(){return locales.map(locale=>({params:{locale}}));}const locale=Astro.params.locale as Locale;const t=text[locale];
const content={en:[['Privacy','This version of apps308 has no registration, newsletter form, advertising scripts or analytics installed. Searching and filtering guides happens in your browser; search terms are not sent to an apps308 application server.'],['Hosting and external websites','The hosting provider may process standard access logs to deliver and secure the website. Following a link to Google, Microsoft, Freecash or another provider takes you to a separate website with its own privacy policy.'],['Device captures','Only captures intended for publication are included. Personal account identifiers are omitted or removed. This website does not access your phone, Google account or Microsoft account.'],['Updates','Last updated: November 5, 2026. Review this page if new features are added.']],es:[['Privacidad','Esta versión de apps308 no incluye registro, boletín, scripts publicitarios ni analítica. La búsqueda y los filtros se ejecutan en tu navegador; no se envían a un servidor de la aplicación.'],['Alojamiento y sitios externos','El proveedor de alojamiento puede procesar registros de acceso para entregar y proteger el sitio. Los enlaces a Google, Microsoft, Freecash y otros proveedores abren sitios independientes con sus propias políticas de privacidad.'],['Capturas de dispositivos','Solo incluimos capturas destinadas a publicación. Los identificadores personales se omiten o eliminan. Este sitio no accede a tu teléfono ni a tus cuentas de Google o Microsoft.'],['Actualizaciones','Última actualización: 5 de noviembre de 2026. Consulta esta página si se añaden funciones.']],pt:[['Privacidade','Esta versão do apps308 não possui cadastro, formulário de newsletter, scripts publicitários ou ferramentas de análise instaladas. Busca e filtros funcionam no navegador; os termos não são enviados a um servidor da aplicação.'],['Hospedagem e sites externos','O provedor de hospedagem pode processar registros de acesso para entregar e proteger o site. Links para Google, Microsoft, Freecash e outros fornecedores levam a sites independentes, com suas próprias políticas de privacidade.'],['Capturas de aparelho','Incluímos apenas capturas destinadas à publicação. Identificadores pessoais são omitidos ou removidos. Este site não acessa seu celular nem suas contas Google e Microsoft.'],['Atualizações','Última atualização: 5 de novembro de 2026. Consulte esta página se novas funções forem adicionadas.']]};
---
<Layout locale={locale} title={`${t.privacy} | apps308`} description={content[locale][0][1]} noindex={true} alternates={Object.fromEntries(locales.map(l=>[l,href(l,'privacy')]))}><div class="policy wrap"><h1>{content[locale][0][0]}</h1><p>{content[locale][0][1]}</p>{content[locale].slice(1).map(([h,p])=><section><h2>{h}</h2><p>{p}</p></section>)}</div></Layout>
