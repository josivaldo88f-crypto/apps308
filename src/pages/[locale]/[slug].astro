---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import AppCover from '../../components/AppCover.astro';import AffiliateBox from '../../components/AffiliateBox.astro';import Card from '../../components/Card.astro';import {Image} from 'astro:assets';import {locales,text,href,category,type Locale} from '../../data/i18n';import {articles,apps,sourcesFor,type Article} from '../../data/articles';
export function getStaticPaths(){return locales.flatMap(locale=>articles[locale].map(article=>({params:{locale,slug:article.slug},props:{article}})));}
const locale=Astro.params.locale as Locale;const {article}=Astro.props as {article:Article};const t=text[locale];
const alternates=Object.fromEntries(locales.map(l=>[l,href(l,articles[l].find(a=>a.id===article.id)!.slug)]));
const url=`https://www.apps308.com${href(locale,article.slug)}`;const source=sourcesFor(article);
const imageFiles=import.meta.glob<{default:ImageMetadata}>('../../assets/screenshots/*.webp',{eager:true});
const imageKey=article.imageKey||(article.app==='compare'?'opinion':article.app==='swagbucks'?'swagbucks-shop':article.app);
const screenshot=imageFiles[`../../assets/screenshots/${locale}-${imageKey}.webp`]?.default;
const extraScreenshot=article.secondImage?imageFiles[`../../assets/screenshots/${locale}-${article.secondImage.key}.webp`]?.default:article.app==='freecash'?imageFiles[`../../assets/screenshots/${locale}-freecash-main.webp`]?.default:article.app==='dramastack'?imageFiles[`../../assets/screenshots/${locale}-dramastack-payout.webp`]?.default:null;
const extraCaption={en:'This Android screen has no offers available. Offer availability depends on your device and region.',es:'Esta pantalla de Android no tiene ofertas disponibles. Las ofertas dependen del dispositivo y la región.',pt:'Nesta tela do Android, não há ofertas disponíveis. A lista varia conforme o aparelho e a região.'};
const payoutCaption={en:'The app displays a R$300 cashout threshold and higher reward levels.',es:'La app muestra un mínimo de retiro de R$300 y niveles superiores.',pt:'O app exibe saque a partir de R$ 300 e níveis de recompensa mais altos.'};
const publishedDate=(article.app==='cashdrama'||article.app==='dramabox'||['nordvpn-vs-surfshark','freecash-reviews','freecash-bonus-cashout','freecash-games-offers'].includes(article.id))?'2026-11-14':article.app==='pinedrama'?'2026-11-13':['nordvpn','surfshark','kaspersky'].includes(article.app)?'2026-11-12':article.app==='primeopinion'?'2026-11-08':article.app==='pawns'?'2026-11-08':article.app==='swagbucks'?'2026-11-07':'2026-11-05';
const modifiedDate=publishedDate>'2026-11-11'?publishedDate:'2026-11-11';
const schema:any[]=[
  {'@context':'https://schema.org','@type':'Article',headline:article.title,description:article.description,inLanguage:locale,datePublished:publishedDate,dateModified:modifiedDate,mainEntityOfPage:url,author:{'@type':'Organization',name:'apps308',url:`https://www.apps308.com${href(locale,'about')}`},publisher:{'@type':'Organization',name:'apps308',url:'https://www.apps308.com'},...(screenshot?{image:new URL(screenshot.src,'https://www.apps308.com').href}:{}),citation:source.map(s=>s.url)},
  {'@context':'https://schema.org','@type':'FAQPage',inLanguage:locale,mainEntity:article.faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))},
  {'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[
    {'@type':'ListItem',position:1,name:'apps308',item:`https://www.apps308.com${href(locale)}`},
    {'@type':'ListItem',position:2,name:category(locale,article.category),item:`https://www.apps308.com${href(locale)}#guides`},
    {'@type':'ListItem',position:3,name:article.title,item:url}
  ]}
];
if(article.app!=='compare')schema.push({'@context':'https://schema.org','@type':'SoftwareApplication',name:apps[article.app].name,url:apps[article.app].url,operatingSystem:apps[article.app].os,applicationCategory:article.app==='lens'?'UtilitiesApplication':(article.app==='dramastack'||article.app==='pinedrama'||article.app==='cashdrama'||article.app==='dramabox')?'EntertainmentApplication':'LifestyleApplication',...(article.app==='lens'?{offers:{'@type':'Offer',price:'0',priceCurrency:'USD'}}:{})});
const date=new Intl.DateTimeFormat(locale,{dateStyle:'medium',timeZone:'UTC'}).format(new Date(`${publishedDate}T12:00:00Z`));
const readTime=Math.max(2,Math.ceil([article.intro,...article.sections.flatMap(s=>s.paragraphs),...article.steps,...article.faq.map(f=>f.a)].join(' ').split(/\s+/).length/180));
const isCluster=['freecash','swagbucks','pawns','primeopinion','pinedrama','cashdrama','dramabox'].includes(article.app);
const clusterSeries=articles[locale].filter(a=>a.app===article.app&&a.id!==article.id);
const clusterHeading={freecash:{en:'Freecash complete guide series',es:'Serie completa de guías sobre Freecash',pt:'Série completa de guias sobre o Freecash'},dramabox:{en:'DramaBox complete guide series',es:'Serie completa de guías sobre DramaBox',pt:'Série completa de guias sobre o DramaBox'},cashdrama:{en:'CashDrama complete guide series',es:'Serie completa de guías sobre CashDrama',pt:'Série completa de guias sobre o CashDrama'},pinedrama:{en:'PineDrama complete guide series',es:'Serie completa de guías sobre PineDrama',pt:'Série completa de guias sobre o PineDrama'},primeopinion:{en:'Prime Opinion complete guide series',es:'Serie completa de guías sobre Prime Opinion',pt:'Série completa de guias sobre o Prime Opinion'},pawns:{en:'Pawns.app complete guide series',es:'Serie completa de guías sobre Pawns.app',pt:'Série completa de guias sobre o Pawns.app'},swagbucks:{en:'Swagbucks complete guide series',es:'Serie completa de guías sobre Swagbucks',pt:'Série completa de guias sobre o Swagbucks'}}[article.app]?.[locale]||'';
const relatedArticles=isCluster
  ?[...clusterSeries.slice(0,2),...articles[locale].filter(a=>a.app!==article.app&&a.id!=='lens').slice(0,1)]
  :[...articles[locale].filter(a=>['primeopinion','pawns','swagbucks'].includes(a.id)),...articles[locale].filter(a=>a.id!==article.id).slice(0,2)];
---
<Layout locale={locale} title={`${article.title} | apps308`} description={article.description} alternates={alternates} schema={schema}>
<div class="wrap"><div class="breadcrumb"><a href={href(locale)}>{t.back}</a><Icon name="chevron" size={10}/><span>{category(locale,article.category)}</span></div><header class="article-header"><span class="eyebrow">{category(locale,article.category)}</span><h1>{article.title}</h1><p class="article-description">{article.description}</p><div class="article-meta"><span>{t.author}</span><span>{t.updated}: <time datetime={publishedDate}>{date}</time></span><span><Icon name="clock" size={13}/>{readTime} {t.minutes}</span></div></header>
<div class="article-layout"><article class="article-body"><div class="article-art"><AppCover app={article.app} variant={article.id} locale={locale} large/></div><p class="intro">{article.intro}</p>
{article.sections.map((section,i)=><section id={`section-${i}`}><h2>{section.heading}</h2>{section.paragraphs.map(p=><p>{p}</p>)}{section.cta&&<p class="section-cta"><a href={section.cta.url} rel={section.cta.sponsored?'sponsored noopener':'noopener'}>{section.cta.label}<Icon name="arrow" size={13}/></a></p>}{section.source&&<p class="section-source"><a href={section.source.url} rel="noopener">{section.source.title}<Icon name="arrow" size={12}/></a></p>}
{i===0&&['swagbucks','pawns','primeopinion','pinedrama','cashdrama','dramabox'].includes(article.app)&&screenshot&&<figure class:list={['article-figure',{'figure-wide':article.imageWide!==false}]}><Image src={screenshot} alt={article.imageAlt} width={article.imageWide===false?320:640} loading="lazy" format="webp"/><figcaption>{article.caption}</figcaption></figure>}
{i===0&&!['swagbucks','pawns','primeopinion','pinedrama','cashdrama','dramabox'].includes(article.app)&&(screenshot||extraScreenshot)&&<figure class="article-figure"><Image src={(article.app==='dramastack'?screenshot:extraScreenshot||screenshot)!} alt={article.app==='dramastack'?article.imageAlt:extraScreenshot?extraCaption[locale]:article.imageAlt} width={320} loading="lazy" format="webp"/><figcaption>{article.app==='dramastack'?article.caption:extraScreenshot?extraCaption[locale]:article.caption}</figcaption></figure>}
{article.app==='dramastack'&&i===0&&extraScreenshot&&<figure class="article-figure figure-wide"><Image src={extraScreenshot} alt={payoutCaption[locale]} width={640} loading="lazy" format="webp"/><figcaption>{payoutCaption[locale]}</figcaption></figure>}
{article.app==='freecash'&&i===1&&screenshot&&<figure class="article-figure figure-wide"><Image src={screenshot} alt={article.imageAlt} width={640} loading="lazy" format="webp"/><figcaption>{article.caption}</figcaption></figure>}
{['swagbucks','pawns','primeopinion','pinedrama','cashdrama','dramabox'].includes(article.app)&&i===1&&extraScreenshot&&article.secondImage&&<figure class:list={['article-figure',{'figure-wide':article.secondImage.wide!==false}]}><Image src={extraScreenshot} alt={article.secondImage.alt} width={article.secondImage.wide===false?320:640} loading="lazy" format="webp"/><figcaption>{article.secondImage.caption}</figcaption></figure>}
{['freecash','swagbucks','pawns','primeopinion'].includes(article.app)&&i===1&&<AffiliateBox locale={locale} app={article.app}/>}
</section>)}
<section id="steps"><h2>{t.steps}</h2><ol>{article.steps.map(step=><li>{step}</li>)}</ol></section>
<div class="pros-cons"><div><h2>{t.pros}</h2><ul>{article.pros.map(p=><li>{p}</li>)}</ul></div><div><h2>{t.cons}</h2><ul>{article.cons.map(p=><li>{p}</li>)}</ul></div></div>
{!['compare','freecash','pawns','primeopinion'].includes(article.app)&&<AffiliateBox locale={locale} app={article.app}/>}
<section class="verdict-box"><h2>{t.verdict}</h2><p>{article.verdict}</p></section>
{isCluster&&<nav class="cluster-box" aria-label={clusterHeading}><h2>{clusterHeading}</h2><ul>{clusterSeries.map(item=><li><a href={href(locale,item.slug)}>{item.title}<Icon name="arrow" size={13}/></a></li>)}</ul></nav>}
<section id="faq"><h2>{t.faq}</h2>{article.faq.map(f=><details class="faq-item"><summary>{f.q}</summary><p>{f.a}</p></details>)}</section>
<section class="sources" id="sources"><h2>{t.source}</h2><ul>{source.map(s=><li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul></section>
</article><aside class="article-sidebar"><h2>{t.contents}</h2>{article.sections.map((s,i)=><a href={`#section-${i}`}>{s.heading}</a>)}<a href="#steps">{t.steps}</a><a href="#faq">{t.faq}</a><a href="#sources">{t.source}</a></aside></div></div>
<section class="article-related wrap"><h2>{t.related}</h2><div class="cards-grid">{relatedArticles.map(a=><Card locale={locale} article={a}/>)}</div></section>
</Layout>
