---
import Layout from '../../layouts/Layout.astro';import Icon from '../../components/Icon.astro';import AppArt from '../../components/AppArt.astro';import Card from '../../components/Card.astro';import {locales,text,href,type Locale} from '../../data/i18n';import {articles} from '../../data/articles';
export function getStaticPaths(){return locales.map(locale=>({params:{locale}}));}
const locale=Astro.params.locale as Locale;const t=text[locale];const list=articles[locale];
---
<Layout locale={locale} title={`apps308 — ${t.news}`} description={t.sub}>
<section class="hero-section wrap"><div class="hero-copy"><span class="eyebrow"><span class="tiny-dot"></span>{t.kicker}</span><h1>{t.hero.split('\n')[0]}<br/><span>{t.hero.split('\n')[1]}</span></h1><p>{t.sub}</p><a href="#guides" class="button-primary">{t.explore}<Icon name="arrow" size={19}/></a><div class="hero-footnote"><span class="circle-check"><Icon name="check" size={12}/></span>{t.latestSub}</div></div>
<div class="hero-display"><div class="hero-grid"></div><span class="hero-corner top-left">+</span><span class="hero-corner bottom-right">+</span><div class="floating-label"><span class="tiny-dot"></span>{t.feature}</div><div class="hero-phone"><div class="phone-notch"></div><div class="phone-brand">apps<span>308</span><b>✳</b></div><div class="phone-heading">{t.compare}</div><div class="phone-tile"><AppArt app="lens"/></div><div class="phone-mini-tiles"><AppArt app="microsoft"/><AppArt app="opinion"/></div><div class="phone-line"></div><div class="phone-line short"></div><div class="phone-home"></div></div><div class="floating-spark">✳</div><div class="floating-note"><span class="note-icon"><Icon name="spark" size={21}/></span><div>{t.featureTitle.split('\n')[0]}<strong>{t.featureTitle.split('\n')[1]}</strong></div><Icon name="arrow" size={18}/></div><div class="hero-number">308</div></div></section>
<div class="trust-strip"><div class="wrap"><span><Icon name="book" size={18}/>{t.guides}</span><span><Icon name="shield" size={18}/>{t.source}</span><span><Icon name="globe" size={18}/>English · Español · Português</span><span class="strip-spark">✳</span></div></div>
<section class="guide-section wrap" id="guides"><div class="section-heading"><div><span class="eyebrow">{t.browseLabel}</span><h2>{t.latest}<span class="heading-dot">.</span></h2><p>{t.latestSub}</p></div><span class="guide-count">{String(list.length).padStart(2,'0')} <span>{t.guides.toLowerCase()}</span></span></div>
<div class="guide-toolbar"><div class="filter-tabs" role="group" aria-label={t.browseLabel}>{['all','rewards','tools','guides'].map((c,i)=><a href={`?category=${c}#guides`} data-filter={c} class:list={['filter-tab',{'is-active':i===0}]} aria-current={i===0?'true':undefined}>{t[c as 'all'|'rewards'|'tools'|'guides']}</a>)}</div><form class="search-form" id="search" role="search"><Icon name="search" size={17}/><label class="sr-only" for="guide-search">{t.search}</label><input type="search" id="guide-search" name="q" placeholder={t.search}/><button type="submit" aria-label={t.searchButton}><Icon name="right" size={17}/></button></form></div>
<div class="cards-grid">{list.map(article=><Card article={article} locale={locale}/>)}</div><p class="empty-results" role="status" hidden>{t.noResults}</p></section>
<section class="method-section wrap"><div class="method-icon"><Icon name="shield" size={34}/></div><div><span class="eyebrow">APPS308</span><h2>{t.method}</h2><p>{t.methodText}</p></div><a href={href(locale,'about')} class="button-outline">{t.about}<Icon name="arrow" size={18}/></a></section>
</Layout>
<script>
const cards=Array.from(document.querySelectorAll<HTMLElement>('.guide-card'));const filters=Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-filter]'));const input=document.querySelector<HTMLInputElement>('#guide-search');let active='all';
function apply(){const query=(input?.value||'').trim().toLocaleLowerCase();let visible=0;cards.forEach(card=>{const show=(active==='all'||card.dataset.category===active)&&(card.dataset.title||'').toLocaleLowerCase().includes(query);card.hidden=!show;if(show)visible++;});filters.forEach(f=>{f.classList.toggle('is-active',f.dataset.filter===active);if(f.dataset.filter===active)f.setAttribute('aria-current','true');else f.removeAttribute('aria-current');});const empty=document.querySelector<HTMLElement>('.empty-results');if(empty)empty.hidden=visible>0;}
filters.forEach(f=>f.addEventListener('click',e=>{e.preventDefault();active=f.dataset.filter||'all';const url=new URL(location.href);url.searchParams.set('category',active);url.hash='guides';history.replaceState(null,'',url);apply();}));input?.addEventListener('input',apply);document.querySelector('#search')?.addEventListener('submit',e=>{e.preventDefault();apply();});const params=new URLSearchParams(location.search);if(['all','rewards','tools','guides'].includes(params.get('category')||''))active=params.get('category')!;if(input)input.value=params.get('q')||'';apply();
</script>
