---
import AppCover from './AppCover.astro';import Icon from './Icon.astro';import {category,href,text,type Locale} from '../data/i18n';import {articles,type Article} from '../data/articles';
const {article,locale}=Astro.props as {article:Article;locale:Locale};const t=text[locale];
const words=[article.intro,...article.sections.flatMap(s=>s.paragraphs),...article.steps,...article.faq.map(f=>f.a)].join(' ').split(/\s+/).length;
const num=String(articles[locale].findIndex(a=>a.id===article.id)+1).padStart(2,'0');
---
<article class="guide-card" data-category={article.category} data-title={`${article.title} ${article.description}`}><a href={href(locale,article.slug)} class="card-visual" tabindex="-1" aria-hidden="true"><AppCover app={article.app} variant={article.id} locale={locale}/><span class="card-arrow"><Icon name="arrow" size={19}/></span></a><div class="card-content"><div class="card-meta"><span>{category(locale,article.category)}</span><span>{num}</span></div><h3><a href={href(locale,article.slug)}>{article.title}</a></h3><p>{article.description}</p><div class="card-bottom"><span><Icon name="clock" size={14}/>{Math.max(2,Math.ceil(words/180))} {t.minutes}</span><a href={href(locale,article.slug)} aria-label={`${t.read}: ${article.title}`}>{t.read}<Icon name="arrow" size={15}/></a></div></div></article>
