---
import {Image} from 'astro:assets';
import type {Locale} from '../data/i18n';
import {apps} from '../data/articles';
const {app,locale,large=false}=Astro.props as {app:string;locale:Locale;large?:boolean};
const files=import.meta.glob<{default:ImageMetadata}>('../assets/screenshots/*.webp',{eager:true});
const names=app==='compare'?['opinion','microsoft','freecash']:app==='freecash'?['freecash-main','freecash']:[app];
const photos=names.map(name=>({name,image:files[`../assets/screenshots/${locale}-${name}.webp`]?.default}));
const label=app==='compare'?{en:'Rewards, compared.',es:'Compara recompensas.',pt:'Compare recompensas.'}[locale]:apps[app].name;
const tag={en:{lens:'Search · Copy · Translate',opinion:'Surveys & Play credit',microsoft:'Points & rewards',freecash:'Games, offers & rewards',compare:'Cash · Points · Credit'},es:{lens:'Busca · Copia · Traduce',opinion:'Encuestas y saldo de Play',microsoft:'Puntos y recompensas',freecash:'Juegos, ofertas y recompensas',compare:'Dinero · Puntos · Crédito'},pt:{lens:'Busque · Copie · Traduza',opinion:'Pesquisas e créditos de Play',microsoft:'Pontos e recompensas',freecash:'Jogos, ofertas e recompensas',compare:'Dinheiro · Pontos · Crédito'}};
---
<div class:list={['app-cover',`cover-${app}`,{large}]}>
  <div class="cover-copy">
    <div class:list={['cover-mark',`mark-${app}`]} aria-hidden="true">
      {app==='microsoft'?<><i></i><i></i><i></i><i></i></>:app==='lens'?<svg viewBox="0 0 64 64"><path d="M8 24V16a8 8 0 0 1 8-8h8" stroke="#ea4335"/><path d="M40 8h8a8 8 0 0 1 8 8v8" stroke="#4285f4"/><path d="M8 40v8a8 8 0 0 0 8 8h8" stroke="#fbbc04"/><circle cx="32" cy="32" r="11" stroke="#4285f4"/><circle cx="51" cy="51" r="7" fill="#34a853" stroke="none"/></svg>:app==='opinion'?<svg viewBox="0 0 64 64"><path d="M17 12h30v24L32 52 17 36Z" fill="#4285f4"/><path d="M23 32l6 6 13-15" fill="none" stroke="white" stroke-width="5"/></svg>:app==='freecash'?<span>F<span>✦</span></span>:<span>↗</span>}
    </div>
    <strong>{label}</strong><span class="cover-tagline">{tag[locale][app as keyof typeof tag.pt]}</span>
    <span class="cover-credit">apps308<span>✳</span></span>
  </div>
  <div class="cover-screens" aria-hidden="true">{photos.map(({name,image},i)=>image&&<div class:list={['cover-screen',`screen-${i+1}`,`screen-${name}`]}><Image src={image} alt={app==='compare'?apps[name].name:label} width={large?440:260} loading="lazy" format="webp"/></div>)}</div>
</div>
