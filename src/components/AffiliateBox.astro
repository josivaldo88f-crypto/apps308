---
import data from '../data/affiliates.json';
import {text,type Locale} from '../data/i18n';
import {apps} from '../data/articles';
import Icon from './Icon.astro';
const {locale,app}=Astro.props as {locale:Locale;app:string};
const t=text[locale];
const program=data.programs[app as keyof typeof data.programs];
const shareUrl='shareUrl' in program ? program.shareUrl as string : null;
const shareLabel={en:'Open app sharing link',es:'Abrir enlace para compartir',pt:'Abrir link de compartilhamento'};
const shareNote={en:'We extracted a generic sharing link from the Android app. It contains no personal code, and we have not verified a bonus for this account.',es:'Extrajimos un enlace genérico para compartir desde la app Android. No contiene código personal ni un bono verificado para esta cuenta.',pt:'Extraímos um link genérico de compartilhamento do app Android. Ele não contém código pessoal nem bônus verificado para esta conta.'};
const affiliateNote={en:'Affiliate link: apps308 may earn a commission if your activity qualifies under the provider’s rules. The identifier below was read from our account’s referral page; it has not been tested as a manually entered bonus code. No welcome bonus is promised.',es:'Enlace de afiliado: apps308 puede recibir una comisión si tu actividad cumple las reglas del proveedor. El identificador se leyó en nuestra página de invitaciones; no se probó como código de bono introducido manualmente. No prometemos un bono de bienvenida.',pt:'Link de afiliado: o apps308 pode receber comissão se sua atividade cumprir as regras do fornecedor. O identificador abaixo foi lido na página de convites da nossa conta; não foi testado como cupom de bônus digitado manualmente. Não prometemos bônus de entrada.'};
const identifier={en:'Referral link identifier',es:'Identificador del enlace',pt:'Identificador do link'};
const copyIdentifier={en:'Copy identifier',es:'Copiar identificador',pt:'Copiar identificador'};
const shareTitle={en:'App sharing link checked',es:'Enlace para compartir verificado',pt:'Link de compartilhamento verificado'};
const verified=program?.status==='verified'&&program?.code&&program?.referralUrl;
---
<aside class="affiliate-box"><div class="affiliate-icon"><Icon name="shield" size={26}/></div><div><h3>{verified?apps[app].name:shareUrl?shareTitle[locale]:app==='lens'?t.noReferral:t.pending}</h3><p>{verified?affiliateNote[locale]:shareUrl?shareNote[locale]:app==='lens'?t.noReferralText:t.pendingText}</p>{verified&&<div class="copy-row"><span class="identifier-label">{identifier[locale]}:</span><code>{program.code}</code><button type="button" data-copy={program.code} data-success={t.copied} data-failure={t.copyFail}>{copyIdentifier[locale]}</button><span role="status" aria-live="polite"></span></div>}<a class="text-link" href={verified?program.referralUrl!:apps[app].url} rel={verified?'sponsored noopener':'noopener'}>{t.visit}<Icon name="arrow" size={15}/></a>{shareUrl&&<p><a class="text-link" href={shareUrl} rel="noopener">{shareLabel[locale]}<Icon name="arrow" size={15}/></a></p>}</div></aside>
{verified&&<script is:inline>
 document.querySelectorAll('[data-copy]').forEach(button=>{button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector('[role=status]');try{await navigator.clipboard.writeText(button.dataset.copy||'');if(status)status.textContent=button.dataset.success||'Copied';}catch{if(status)status.textContent=button.dataset.failure||'Copy manually';}});});
</script>}
