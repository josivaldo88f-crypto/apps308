---
import data from '../data/affiliates.json';
import {text,type Locale} from '../data/i18n';
import {apps} from '../data/articles';
import Icon from './Icon.astro';
const {locale,app}=Astro.props as {locale:Locale;app:string};
const t=text[locale];
const program=data.programs[app as keyof typeof data.programs];
const hasInvite=program?.status==='verified'&&program?.code&&program?.referralUrl;
const open={en:'Open Freecash',es:'Acceder a Freecash',pt:'Acessar o Freecash'};
---
<aside class:list={['app-access',{'has-invite':hasInvite}]} aria-label={apps[app].name}>
  <div class="access-heading"><strong>{apps[app].name}</strong></div>
  {hasInvite&&<div class="copy-row"><code>{program.code}</code><button type="button" data-copy={program.code} data-success={t.copied} data-failure={t.copyFail}>{t.copy}</button><span role="status" aria-live="polite"></span></div>}
  <a class="access-button" href={hasInvite?program.referralUrl!:apps[app].url} rel={hasInvite?'sponsored noopener':'noopener'}>{hasInvite?open[locale]:t.visit}<Icon name="arrow" size={17}/></a>
</aside>
{hasInvite&&<script is:inline>
 document.querySelectorAll('[data-copy]').forEach(button=>{button.addEventListener('click',async()=>{const status=button.parentElement?.querySelector('[role=status]');try{await navigator.clipboard.writeText(button.dataset.copy||'');if(status)status.textContent=button.dataset.success||'Copied';}catch{if(status)status.textContent=button.dataset.failure||'Copy manually';}});});
</script>}
