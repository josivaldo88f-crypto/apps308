---
import data from '../data/affiliates.json';
import {text,type Locale} from '../data/i18n';
import {apps} from '../data/articles';
import Icon from './Icon.astro';
import CopyCode from './CopyCode.astro';
const {locale,app}=Astro.props as {locale:Locale;app:string};
const t=text[locale];
const program=data.programs[app as keyof typeof data.programs] as {status?:string;code?:string|null;referralUrl?:string|null;localeUrls?:Record<string,string>}|undefined;
const targetUrl=program?.localeUrls?.[locale]||program?.referralUrl;
const hasInvite=program?.status==='verified'&&Boolean(targetUrl);
const hasCodeCopy=(app==='freecash'||app==='pawns'||app==='primeopinion'||app==='attapoll'||app==='tiktoklite')&&Boolean(program?.code);
const open:Record<string,Record<Locale,string>>={
  freecash:{en:'Open Freecash',es:'Acceder a Freecash',pt:'Acessar o Freecash'},
  swagbucks:{en:'Sign up on Swagbucks',es:'Registrarse en Swagbucks',pt:'Criar conta no Swagbucks'},
  pawns:{en:'View Pawns.app invitation terms',es:'Ver condiciones de invitación de Pawns.app',pt:'Ver condições do convite Pawns.app'},
  primeopinion:{en:'Join Prime Opinion (+10% Bonus)',es:'Unirse a Prime Opinion (Bono +10%)',pt:'Entrar no Prime Opinion (Bônus +10%)'},
  nordvpn:{en:'View NordVPN official offer',es:'Ver oferta oficial de NordVPN',pt:'Ver oferta oficial da NordVPN'},
  surfshark:{en:'View Surfshark official offer',es:'Ver oferta oficial de Surfshark',pt:'Ver oferta oficial do Surfshark'},
  kaspersky:{en:'View Kaspersky official offer',es:'Ver oferta oficial de Kaspersky',pt:'Ver oferta oficial do Kaspersky'},
  attapoll:{en:'Download AttaPoll via invite',es:'Descargar AttaPoll con invitación',pt:'Baixar o AttaPoll pelo convite'},
  tiktoklite:{en:'Download TikTok Lite via invite',es:'Descargar TikTok Lite con invitación',pt:'Baixar o TikTok Lite pelo convite'}
};
const subtext:Record<string,Record<Locale,string>>={
  swagbucks:{
    en:'Official registration link — create your free account to browse surveys, mobile game milestones, and cashback deals.',
    es:'Enlace de invitación — crea tu cuenta gratuita para explorar encuestas, metas en juegos móviles y reembolsos de compras.',
    pt:'Link de convite para cadastro — crie sua conta gratuita para ver pesquisas, metas em jogos no celular e ofertas de cashback.'
  },
  pawns:{
    en:'Invitation code 6823713 — the $3 referral reward is split into $1 after each of the first three eligible cashouts. Check eligibility and deadlines in your account.',
    es:'Código de invitación 6823713 — el bono de $3 se divide en $1 después de cada uno de los tres primeros retiros válidos. Consulta requisitos y plazos en tu cuenta.',
    pt:'Código de convite 6823713 — o bônus de US$ 3 é dividido em US$ 1 após cada um dos três primeiros saques elegíveis. Confira os requisitos e prazos na sua conta.'
  },
  primeopinion:{
    en:'Official sign-up link — redeem bonus code ALNTFL within 24 hours of registration to get an extra +10% bonus on all surveys.',
    es:'Enlace oficial de registro — ingresa el código de bono ALNTFL dentro de las primeras 24 horas para ganar un +10% extra en todas las encuestas.',
    pt:'Link oficial de cadastro — ative o código de bônus ALNTFL nas primeiras 24 horas para garantir +10% de ganho extra em todas as pesquisas.'
  },
  nordvpn:{
    en:'Partner link — check current multi-device VPN plans and Threat Protection options directly on the official NordVPN page.',
    es:'Enlace de afiliado — consulta los planes vigentes de VPN multidispositivo y Protección contra amenazas en la página oficial de NordVPN.',
    pt:'Link de parceiro — confira os planos vigentes de VPN multidispositivo e Proteção contra ameaças na página oficial da NordVPN.'
  },
  surfshark:{
    en:'Partner link — check current Surfshark plans with unlimited simultaneous devices and CleanWeb filtering on the official site.',
    es:'Enlace de afiliado — consulta los planes vigentes de Surfshark con dispositivos ilimitados y bloqueo CleanWeb en el sitio oficial.',
    pt:'Link de parceiro — confira os planos vigentes do Surfshark com dispositivos ilimitados e bloqueio CleanWeb no site oficial.'
  },
  kaspersky:{
    en:'Partner link — check current Kaspersky antivirus and mobile security plans on the official regional page.',
    es:'Enlace de afiliado — consulta los planes vigentes de antivirus y protección móvil de Kaspersky en la página oficial.',
    pt:'Link de parceiro — confira os planos vigentes de antivírus e proteção móvel do Kaspersky na página oficial.'
  },
  pinedrama:{
    en:'Official TikTok short-drama portal — check store availability and privacy rules before installing.',
    es:'Portal oficial de dramas cortos de TikTok — verifica la disponibilidad en tienda y las reglas de privacidad antes de instalar.',
    pt:'Portal oficial de dramas curtos do TikTok — confira a disponibilidade na loja e as regras antes de instalar.'
  },
  cashdrama:{
    en:'Official Google Play listing — check developer details, ad frequency, and withdrawal rules before spending time on tasks.',
    es:'Ficha oficial en Google Play — revisa el desarrollador, la carga de anuncios y las reglas de retiro antes de invertir tiempo.',
    pt:'Página oficial na Google Play — confira o desenvolvedor, o volume de anúncios e as travas de saque antes de perder tempo.'
  },
  dramabox:{
    en:'Official Google Play listing (StoryMatrix) — watch free episodes, earn coins via ads and daily check-ins, or review plan terms before subscribing.',
    es:'Ficha oficial en Google Play (StoryMatrix) — mira episodios gratis, gana monedas con anuncios y tareas o revisa los planes antes de suscribirte.',
    pt:'Página oficial na Google Play (StoryMatrix) — assista aos primeiros episódios grátis, ganhe moedas com anúncios e tarefas ou confira os planos antes de assinar.'
  },
  dramagood:{
    en:'Official Google Play listing (Short Drama Workgroup) — review the app description and privacy policy before spending time on its tasks.',
    es:'Ficha oficial en Google Play (Short Drama Workgroup) — revisa la descripción y la política de privacidad antes de invertir tiempo en sus tareas.',
    pt:'Página oficial na Google Play (Short Drama Workgroup) — confira a descrição e a política de privacidade antes de gastar tempo com as tarefas.'
  },
  attapoll:{
    en:'Invitation code cgfky — review program rules and the seven-day manual registration window in the app.',
    es:'Código de invitación cgfky — revisa las condiciones del programa y el plazo de siete días en la app.',
    pt:'Código de convite cgfky — confira as condições do programa e o prazo de sete dias para indicação manual diretamente no aplicativo.'
  },
  tiktoklite:{
    en:'Invite code DL70959891 (#DL70959891) — available for eligible new accounts and devices; check local campaign rules in the Rewards tab.',
    es:'Código de invitación DL70959891 (#DL70959891) — válido para cuentas y dispositivos nuevos elegibles; revisa las reglas locales en la pestaña de Recompensas.',
    pt:'Código de convite DL70959891 (#DL70959891) — válido para contas e aparelhos novos elegíveis; confira as regras da campanha na aba Recompensas.'
  }
};
const store={en:'Get it on Google Play',es:'Descargar en Google Play',pt:'Baixar na Google Play'};
---
<aside class:list={['app-access',{'has-invite':hasInvite,'access-swagbucks':app==='swagbucks','access-pawns':app==='pawns','access-primeopinion':app==='primeopinion','access-attapoll':app==='attapoll','access-tiktoklite':app==='tiktoklite'}]} aria-label={apps[app].name}>
  <div class="access-heading">
    <strong>{apps[app].name}</strong>
    {subtext[app]&&<p class="access-sub">{subtext[app][locale]}</p>}
  </div>
  {hasCodeCopy&&program?.code&&<CopyCode code={program.code} locale={locale}/>}
  <a class="access-button" href={hasInvite?targetUrl!:apps[app].url} rel={hasInvite?'sponsored noopener':'noopener'}>{hasInvite?(open[app]?.[locale]||t.visit):(app==='dramastack'||app==='cashdrama'||app==='dramabox'||app==='dramagood')?store[locale]:t.visit}<Icon name="arrow" size={17}/></a>
</aside>
